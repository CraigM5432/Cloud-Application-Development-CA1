<h1 class="mb-4">Tasks</h1>

<div class="mb-3">
  <strong>Sort by:</strong>
  <%= link_to "Priority", tasks_path(sort: "priority"), class: "btn btn-outline-primary btn-sm" %>
  <%= link_to "Due Date", tasks_path(sort: "due_date"), class: "btn btn-outline-primary btn-sm" %>
  <%= link_to "Completion", tasks_path(sort: "completed"), class: "btn btn-outline-primary btn-sm" %>
  <%= link_to "Reset", tasks_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<div class="mb-3">
  <%= link_to "New Task", new_task_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Title</th>
      <th>Priority</th>
      <th>Due date</th>
      <th>Completed</th>
      <th>Reminder</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.priority %></td>
        <td><%= task.due_date&.strftime("%d %b %Y %H:%M") %></td>

        <td>
          <% if task.completed %>
            <span class="badge bg-success">Done</span>
          <% else %>
            <span class="badge bg-warning text-dark">Pending</span>
          <% end %>
        </td>

        <td>
          <% if task.reminded_at.present? %>
            <span style="color: green; font-weight: bold;">
              Reminded
            </span><br>
            <small><%= task.reminded_at.strftime("%d %b %Y %H:%M") %></small>

          <% elsif task.reminder_at.present? %>
            <span style="color: orange;">
              Scheduled
            </span>

          <% else %>
            <span style="color: grey;">
              — No reminder —
            </span>
          <% end %>
        </td>

        <td>
          <%= link_to "Show", task, class: "btn btn-sm btn-outline-primary" %>
          <%= link_to "Edit", edit_task_path(task), class: "btn btn-sm btn-outline-secondary" %>
          <%= link_to "Delete", task,
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this task?"
                },
                class: "btn btn-sm btn-outline-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

